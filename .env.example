# Sites provisions DB and BUCKET from .openai/hosting.json.
# No application secrets are required for the current manual signing workflow.
# Never store production secrets or personal data in this file.

# Vercel only: HTTPS origin of the Cloudflare deployment with DB/BUCKET bindings.
# Example: https://your-crm-backend.your-subdomain.workers.dev
# Do not point this at the Vercel application itself.
CLOUDFLARE_BACKEND_ORIGIN=
